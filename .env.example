# Optional hosted AI gateway. Without this value, the app runs with a local demo planner.
VITE_THINKABLE_API_URL=https://your-thinkable-api.vercel.app

# Desktop main-process gateway URL for multi-turn autonomous agent tasks.
# This value is not bundled into the renderer.
THINKABLE_API_URL=https://your-thinkable-api.vercel.app

# ── Neon Serverless PostgreSQL (REQUIRED for cloud mode) ──
# Get these from https://console.neon.tech → your project → Connection Details
NEON_CONNECTION_STRING=postgresql://neondb_owner:<password>@<endpoint>-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_ENDPOINT=https://<endpoint>-pooler.c-3.ap-southeast-1.aws.neon.tech/sql

# Server-only values (never expose these to the Electron renderer / client bundle).
OPENAI_API_KEY=
OPENAI_MODEL=
THINKABLE_MODEL_PROVIDER=openai
SUPABASE_URL=
SUPABASE_ANON_KEY=
